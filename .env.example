# Copy to .env for local development (.env is git-ignored).
# JWT_SECRET: HS256 signing key, at least 32 characters.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
# ADMIN_SECRET: required in the X-Admin-Secret header to obtain an admin token.
ADMIN_SECRET=replace-with-a-random-admin-secret
